{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "src/web",
    "outDir": "dist/web",
    "declaration": true,
    "composite": true,
    "jsx": "react-jsx"
  },
  "include": ["src/web"],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
