{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2024",
    "lib": ["ES2025"],
    "types": ["node"],
    "module": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "composite": true
  },
  "include": ["src"],
  "exclude": ["src/web", "src/api_spec.ts", "src/plugins.ts", "src/sql.ts", "src/sync_protocol.ts", "src/units.ts", "src/dates.ts", "src/money.ts"],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
