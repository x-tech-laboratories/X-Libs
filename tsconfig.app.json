{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2024",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "nodenext",
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "composite": true
  },
  "include": ["src/app"],
  "references": [{ "path": "./tsconfig.shared.json" }, { "path": "./tsconfig.node.json" }, { "path": "./tsconfig.web.json" }]
}
